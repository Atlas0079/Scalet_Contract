config_version=5

[application]
config/name="铁眼 · 舱室"
run/main_scene="res://presentation/cabin/cabin.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/subwindows/embed_subwindows=true

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.027,0.067,0.071,1)

[debug]
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_call_argument=0
